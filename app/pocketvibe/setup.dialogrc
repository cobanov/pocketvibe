# The first-run setup screen in PocketVibe's colors. PocketVibe.sh sets the
# terminal's palette so that black is the app's background, blue its panel,
# yellow its accent and white its text.
use_shadow = OFF
use_colors = ON
screen_color = (WHITE,BLACK,OFF)
shadow_color = (BLACK,BLACK,OFF)
dialog_color = (WHITE,BLUE,OFF)
title_color = (YELLOW,BLUE,ON)
border_color = (BLUE,BLUE,OFF)
border2_color = (BLUE,BLUE,OFF)
gauge_color = (YELLOW,BLUE,ON)
button_active_color = (BLACK,YELLOW,ON)
button_inactive_color = (WHITE,BLUE,OFF)
button_key_active_color = (BLACK,YELLOW,ON)
button_key_inactive_color = (YELLOW,BLUE,ON)
button_label_active_color = (BLACK,YELLOW,ON)
button_label_inactive_color = (WHITE,BLUE,ON)
